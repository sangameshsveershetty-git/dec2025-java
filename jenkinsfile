pipeline {
    agent any
    environment {
        PATH="/opt/maven/bin/:$PATH"
    }

    stages {
        stage('Git Checkout') {
            steps {
                git 'https://github.com/sangameshsveershetty-git/dec2025-java.git'
            }
        }

        stage('Maven Check') {
            steps {
                sh 'mvn --version'
            }
        }

        stage('Build Package') {
            steps {
                // Performs the actual build
                sh 'mvn -B -DskipTests clean package'
                sh 'mvn validate'
                sh 'mvn install'
            }
        } 

        stage('validation') {
            steps {
                // Performs the actual build
                sh 'mvn validate'
                
            }
        }         
    }
}
