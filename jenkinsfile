pipeline {
    agent any
    // environment {
    //     PATH="/opt/maven/bin/:$PATH"
    // }
    tools {
        maven 'maven3.9.10'
    }

    stages {
        stage('shiva-Git Checkout') {
            steps {
                git 'https://github.com/sangameshsveershetty-git/dec2025-java.git'
            }
        }

        stage('shiva-Maven Check') {
            steps {
                sh 'maven --version'
            }
        }

        stage('shiva-Build Package') {
            steps {
                // Performs the actual build
                sh 'maven -B -DskipTests clean package'
                // sh 'maven validate'
                // sh 'maven install'
            }
        } 

        stage('validation') {
            steps {
                // Performs the actual build
                sh 'maven validate'
                
            }
        }         
    }
}
