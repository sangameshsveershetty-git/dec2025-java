pipeline {
    agent any
    // environment {
    //     PATH="/opt/maven/bin/:$PATH"
    // }
    tools {
        maven 'maven3.9.12'
    }
    stages {
        stage('shiva-Git') {
            steps {
                git 'https://github.com/sangameshsveershetty-git/dec2025-java.git'
            }
        }
        stage('shiva-maven-check') {
            steps {
                sh 'mvn --version'
            }
        }

        stage('shiva-Build Package') {
            steps {
                sh 'mvn -B -DskipTests clean package'
                // sh 'maven validate'
                // sh 'maven install'
            }
        } 

        stage('validation') {
            steps {
                sh 'mvn validate'
                
            }
        }         
    }
}
